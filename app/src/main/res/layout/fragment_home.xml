<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_background">

    <!-- Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Title Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_your_digital_library"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover and manage your collection of 8 books"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <!-- Filter Bar - View Toggle and Books Count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <!-- Books Found Count -->
                <TextView
                    android:id="@+id/tv_books_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 books found"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- View Toggle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_icon_button"
                    android:padding="3dp">

                    <ImageButton
                        android:id="@+id/btn_grid_view"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_grid"
                        android:background="@drawable/bg_category_tag"
                        android:contentDescription="@string/cd_grid_view"
                        android:padding="5dp" />

                    <ImageButton
                        android:id="@+id/btn_list_view"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_list"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/cd_list_view"
                        android:padding="5dp"
                        android:layout_marginStart="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Books Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:listitem="@layout/item_book_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
