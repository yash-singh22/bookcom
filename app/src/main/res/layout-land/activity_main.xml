<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/main_background"
        android:fitsSystemWindows="true">

        <!-- Top App Bar - Landscape Optimized -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/sidebar_background">

            <!-- Menu Button -->
            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_menu"
                android:padding="8dp" />

            <!-- App Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/app_logo"
                    android:contentDescription="@string/cd_app_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Search Bar - Inline in landscape -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/SearchEditTextStyle"
                    android:hint="@string/search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/cd_search"
                    app:tint="@color/text_hint" />
            </FrameLayout>

            <!-- Upload Button -->
            <ImageButton
                android:id="@+id/btn_upload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_upload_button"
                android:contentDescription="@string/upload_book"
                android:padding="8dp" />

            <!-- Profile -->
            <FrameLayout
                android:id="@+id/btn_profile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_profile_circle">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="@string/cd_profile" />
            </FrameLayout>
        </LinearLayout>

        <!-- Fragment Container -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- Navigation Drawer -->
    <LinearLayout
        android:id="@+id/nav_drawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/sidebar_background"
        android:fitsSystemWindows="true">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/app_logo"
                android:contentDescription="@string/cd_app_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/sidebar_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/sidebar_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Navigation -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/nav_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_home"
                    android:drawableStart="@drawable/ic_home"
                    android:background="@drawable/bg_nav_item_selected"
                    style="@style/NavItemStyle" />

                <TextView
                    android:id="@+id/nav_library"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_my_library"
                    android:drawableStart="@drawable/ic_library"
                    android:background="@drawable/bg_nav_item"
                    style="@style/NavItemStyle"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/nav_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_favorites"
                    android:drawableStart="@drawable/ic_favorite_outline"
                    android:background="@drawable/bg_nav_item"
                    style="@style/NavItemStyle"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/nav_downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Downloads"
                    android:drawableStart="@drawable/ic_download"
                    android:background="@drawable/bg_nav_item"
                    style="@style/NavItemStyle"
                    android:layout_marginTop="4dp" />

                <!-- Categories Section -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CATEGORIES"
                    android:textColor="@color/sidebar_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/nav_cat_romance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Romance"
                    android:drawableStart="@drawable/bg_library_indicator"
                    android:drawablePadding="16dp"
                    android:background="@drawable/bg_nav_item"
                    style="@style/NavItemStyle" />

                <TextView
                    android:id="@+id/nav_cat_biography"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Biography"
                    android:drawableStart="@drawable/bg_library_indicator"
                    android:drawablePadding="16dp"
                    android:background="@drawable/bg_nav_item"
                    style="@style/NavItemStyle"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/nav_cat_science"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Science"
                    android:drawableStart="@drawable/bg_library_indicator"
                    android:drawablePadding="16dp"
                    android:background="@drawable/bg_nav_item"
                    style="@style/NavItemStyle"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/nav_cat_textbook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Textbook"
                    android:drawableStart="@drawable/bg_library_indicator"
                    android:drawablePadding="16dp"
                    android:background="@drawable/bg_nav_item"
                    style="@style/NavItemStyle"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/nav_cat_mystery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mystery"
                    android:drawableStart="@drawable/bg_library_indicator"
                    android:drawablePadding="16dp"
                    android:background="@drawable/bg_nav_item"
                    style="@style/NavItemStyle"
                    android:layout_marginTop="2dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/nav_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_help_support"
                android:drawableStart="@drawable/ic_help"
                android:background="@drawable/bg_nav_item"
                style="@style/NavItemStyle" />

            <TextView
                android:id="@+id/nav_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings"
                android:drawableStart="@drawable/ic_settings"
                android:background="@drawable/bg_nav_item"
                style="@style/NavItemStyle"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/nav_signout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_sign_out"
                android:drawableStart="@drawable/ic_logout"
                android:background="@drawable/bg_nav_item"
                style="@style/NavItemStyle"
                android:textColor="@color/primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
