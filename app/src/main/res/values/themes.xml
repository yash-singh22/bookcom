<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Bookcom" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        
        <!-- Window background. -->
        <item name="android:windowBackground">@color/main_background</item>
        
        <!-- Status bar and navigation bar colors. -->
        <item name="android:statusBarColor">@color/sidebar_background</item>
        <item name="android:navigationBarColor">@color/sidebar_background</item>

        <!-- Ensure icons are visible on light background -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
    </style>

    <style name="Theme.Bookcom" parent="Base.Theme.Bookcom" />
    
    <!-- Search EditText Style -->
    <style name="SearchEditTextStyle">
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingStart">36dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    
    <!-- Navigation Item Style -->
    <style name="NavItemStyle">
        <item name="android:textColor">@color/sidebar_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/sidebar_text</item>
    </style>
    
    <!-- Button Style -->
    <style name="ReadButtonStyle">
        <item name="android:background">@drawable/bg_button_read</item>
        <item name="android:textColor">@color/black</item> <!-- Text color on yellow button -->
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    
    <!-- Category Tag Style -->
    <style name="CategoryTagStyle">
        <item name="android:background">@drawable/bg_category_tag</item>
        <item name="android:textColor">@color/black</item> <!-- Text color on yellow tag -->
        <item name="android:textSize">10sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
</resources>
